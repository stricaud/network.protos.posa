# WebSocket protocol decoder — RFC 6455
# Detects WebSocket frames by their first-byte patterns (FIN + opcode).
# WebSocket is negotiated via HTTP Upgrade; data frames follow on the same TCP connection.
# Client-to-server frames are masked (MASK bit set); server-to-client frames are unmasked.

Object<main> WebSocket
    abbrev "ws"
    col "WebSocket"

    # Byte 0: FIN flag, reserved bits, and opcode
    uint8 flags_opcode "Flags/Opcode" defaults(0x81)
    bits flags_opcode fin      7 1 "FIN"
    bits flags_opcode rsv1     6 1 "RSV1"
    bits flags_opcode rsv2     5 1 "RSV2"
    bits flags_opcode rsv3     4 1 "RSV3"
    bits flags_opcode opcode   0 4 "Opcode"
        CONTINUATION = 0
        TEXT         = 1
        BINARY       = 2
        CLOSE        = 8
        PING         = 9
        PONG         = 10

    # Byte 1: MASK flag and 7-bit base payload length
    uint8 mask_len_byte "Mask/Length" defaults(0x80)
    bits mask_len_byte mask        7 1 "Mask"
    bits mask_len_byte payload_len 0 7 "Payload Length"

    # Extended payload length — only present when base payload_len indicates it
    when payload_len == 126:
        uint16 ext_payload_len "Extended Payload Length" defaults(0)
    when payload_len == 127:
        uint64 ext_payload_len_64 "Extended Payload Length (64-bit)" defaults(0)

    # Masking key — 4 bytes, present only when MASK bit is set (client frames)
    when mask == 1:
        bytes<4> masking_key "Masking Key"

    # Payload data (XOR-masked when MASK bit is set)
    payload

    info "%s len=%u" opcode, payload_len

# ── Content detection (PRIMARY — port-independent) ──────────────────────────
# Match the most common WebSocket frame first bytes: FIN(1) + opcode
# 0x81 = FIN + TEXT, 0x82 = FIN + BINARY
# 0x88 = FIN + CLOSE, 0x89 = FIN + PING, 0x8A = FIN + PONG
weak rule tcp.content "\x81" => WebSocket
weak rule tcp.content "\x82" => WebSocket
weak rule tcp.content "\x88" => WebSocket
weak rule tcp.content "\x89" => WebSocket
weak rule tcp.content "\x8A" => WebSocket

# ── No port bindings, deliberately ───────────────────────────────────────────
# WebSocket has no port of its own. It begins life as an HTTP request carrying
# `Upgrade: websocket`, and only then do frames start flowing — over whatever
# port that HTTP connection was already using, which is 80 or 443 almost every
# time. Claiming those ports here would take them from HTTP and TLS, and a port
# binding outranks the weak signatures above: a TLS ClientHello on 443 would be
# decoded as a WebSocket frame (0x16 reads as a valid opcode) and its SNI would
# never be seen. The signatures are what recognise WebSocket, and they are asked
# after the port bindings, which is the right way round for a protocol that
# borrows someone else's port.

# ── Coloring rules ───────────────────────────────────────────────────────────
# Text frames — green
color ws.opcode == 1  => black lightgreen
# Binary frames — blue
color ws.opcode == 2  => black lightblue
# Continuation frames — light gray
color ws.opcode == 0  => black lightgray
# Control frames (close, ping, pong) — gray
color ws.opcode == 8  => black lightgray
color ws.opcode == 9  => black lightgray
color ws.opcode == 10 => black lightgray

# ── Wireshark-compatible aliases ─────────────────────────────────────────────
alias websocket.opcode      => ws.opcode
alias websocket.payload_len => ws.payload_len
alias websocket.mask        => ws.mask
