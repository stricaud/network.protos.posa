# Modbus TCP (MBAP header + PDU) — Modbus Application Protocol v1.1b3,
# Modbus Messaging on TCP/IP Implementation Guide v1.0b
#
# TCP port 502. protocol_id is always 0 for Modbus. unit_id identifies the slave
# device behind a gateway (0xFF when the target is the TCP endpoint itself).
#
# Frame layout:
#   MBAP header (7 bytes)   transaction_id, protocol_id, length, unit_id
#   PDU                     function_code + a body whose shape depends on it
#
# `length` counts unit_id plus the PDU, so the `scope length` below ends the
# object exactly where the MBAP header says it does — a short read leaves the
# remaining bytes undecoded rather than running off the end.
#
# Request vs response
# ───────────────────
# Modbus carries no direction bit: a dissector tells a request from a response
# by which side of TCP/502 the packet came from, and a posa guard cannot see
# the ports. The bodies are distinguished by size instead — `remaining` inside
# the scope is `length - 2`, the PDU body byte count, and for most function
# codes the two directions have different body sizes.
#
# One case stays ambiguous: a READ_COILS / READ_DISCRETE_INPUTS response
# carrying a 3-byte coil status (byte_count=3, body=4) is the same size as the
# 4-byte request body, and is decoded as a request. Registers are always 2
# bytes each, so function codes 3 and 4 are not affected.
#
# Error responses set the high bit of the function code (READ_HOLDING_REGISTERS
# error = 0x83) and carry a single exception code.

Object<main> ModbusTCP
    col "Modbus/TCP"

    uint16 transaction_id ["Transaction Identifier"] defaults(1)
    uint16 protocol_id ["Protocol Identifier"] defaults(0)
        Modbus = 0
    uint16 length ["Length"] defaults(6)

    scope length
        uint8 unit_id ["Unit Identifier"] defaults(1)
        uint8 function_code ["Function Code"] defaults(3)
            READ_COILS               = 1
            READ_DISCRETE_INPUTS     = 2
            READ_HOLDING_REGISTERS   = 3
            READ_INPUT_REGISTERS     = 4
            WRITE_SINGLE_COIL        = 5
            WRITE_SINGLE_REGISTER    = 6
            READ_EXCEPTION_STATUS    = 7
            DIAGNOSTICS              = 8
            WRITE_MULTIPLE_COILS     = 15
            WRITE_MULTIPLE_REGISTERS = 16
            REPORT_SERVER_ID         = 17
            READ_FILE_RECORD         = 20
            WRITE_FILE_RECORD        = 21
            MASK_WRITE_REGISTER      = 22
            READ_WRITE_MULTIPLE      = 23
            READ_FIFO_QUEUE          = 24
            MEI_TRANSPORT            = 43

        # ── Error response — function_code | 0x80, one exception code ─────────
        when function_code >= 0x80:
            uint8 exception_code ["Exception Code"] defaults(1)
                ILLEGAL_FUNCTION                        = 1
                ILLEGAL_DATA_ADDRESS                    = 2
                ILLEGAL_DATA_VALUE                      = 3
                SERVER_DEVICE_FAILURE                   = 4
                ACKNOWLEDGE                             = 5
                SERVER_DEVICE_BUSY                      = 6
                NEGATIVE_ACKNOWLEDGE                    = 7
                MEMORY_PARITY_ERROR                     = 8
                GATEWAY_PATH_UNAVAILABLE                = 10
                GATEWAY_TARGET_DEVICE_FAILED_TO_RESPOND = 11

        # ── 0x01 READ_COILS, 0x02 READ_DISCRETE_INPUTS ────────────────────────
        # Request  : starting address + quantity of bits   (4 bytes)
        # Response : byte count + packed bit status        (1 + N bytes)
        when function_code == 1 or function_code == 2:
            when remaining == 4:
                uint16 start_address ["Starting Address"] defaults(0)
                uint16 quantity ["Quantity of Bits"] defaults(1)
            else:
                uint8 byte_count ["Byte Count"] defaults(1)
                bytes[byte_count] bit_status ["Status"]

        # ── 0x03 READ_HOLDING_REGISTERS, 0x04 READ_INPUT_REGISTERS ────────────
        # Request  : starting address + quantity of registers  (4 bytes)
        # Response : byte count + 2 bytes per register         (1 + 2N bytes)
        when function_code == 3 or function_code == 4:
            when remaining == 4:
                uint16 start_address ["Starting Address"] defaults(0)
                uint16 quantity ["Quantity of Registers"] defaults(1)
            else:
                uint8 byte_count ["Byte Count"] defaults(2)
                repeat byte_count/2 as register ["Registers"]
                    uint16 value ["Register Value"] defaults(0)

        # ── 0x05 WRITE_SINGLE_COIL, 0x06 WRITE_SINGLE_REGISTER ────────────────
        # The response echoes the request, so both directions share one layout.
        when function_code == 5 or function_code == 6:
            uint16 address ["Output Address"] defaults(0)
            uint16 value ["Output Value"] defaults(0)

        # ── 0x07 READ_EXCEPTION_STATUS ────────────────────────────────────────
        # Request carries no body; the response is a single status byte.
        when function_code == 7:
            when remaining >= 1:
                uint8 exception_status ["Exception Status"] defaults(0)

        # ── 0x08 DIAGNOSTICS — sub-function plus its data, echoed in the reply ─
        when function_code == 8:
            uint16 sub_function ["Sub-function"] defaults(0)
                RETURN_QUERY_DATA               = 0
                RESTART_COMMUNICATIONS_OPTION   = 1
                RETURN_DIAGNOSTIC_REGISTER      = 2
                CHANGE_ASCII_INPUT_DELIMITER    = 3
                FORCE_LISTEN_ONLY_MODE          = 4
                CLEAR_COUNTERS_AND_DIAGNOSTIC   = 10
                RETURN_BUS_MESSAGE_COUNT        = 11
                RETURN_BUS_COMM_ERROR_COUNT     = 12
                RETURN_BUS_EXCEPTION_ERROR_COUNT = 13
                RETURN_SERVER_MESSAGE_COUNT     = 14
                RETURN_SERVER_NO_RESPONSE_COUNT = 15
            payload diagnostic_data ["Diagnostic Data"]

        # ── 0x0F WRITE_MULTIPLE_COILS, 0x10 WRITE_MULTIPLE_REGISTERS ──────────
        # Request  : address + quantity + byte count + data  (5 + N bytes)
        # Response : address + quantity                      (4 bytes)
        when function_code == 15 or function_code == 16:
            uint16 start_address ["Starting Address"] defaults(0)
            uint16 quantity ["Quantity"] defaults(1)
            when remaining >= 1:
                uint8 byte_count ["Byte Count"] defaults(2)
                bytes[byte_count] write_data ["Data"]

        # ── 0x11 REPORT_SERVER_ID — no request body; response is opaque ───────
        when function_code == 17:
            when remaining >= 1:
                uint8 byte_count ["Byte Count"] defaults(1)
                bytes[byte_count] server_id ["Server ID"]

        # ── 0x16 MASK_WRITE_REGISTER — echoed in the reply ────────────────────
        when function_code == 22:
            uint16 reference_address ["Reference Address"] defaults(0)
            uint16 and_mask ["AND Mask"] defaults(0xffff)
            uint16 or_mask ["OR Mask"] defaults(0)

        # ── 0x17 READ_WRITE_MULTIPLE_REGISTERS ────────────────────────────────
        # Request  : read address/count + write address/count + byte count + data
        # Response : byte count + the registers that were read
        when function_code == 23:
            when remaining >= 9:
                uint16 read_start_address ["Read Starting Address"] defaults(0)
                uint16 read_quantity ["Quantity to Read"] defaults(1)
                uint16 write_start_address ["Write Starting Address"] defaults(0)
                uint16 write_quantity ["Quantity to Write"] defaults(1)
                uint8 byte_count ["Write Byte Count"] defaults(2)
                bytes[byte_count] write_data ["Write Data"]
            else:
                uint8 byte_count ["Byte Count"] defaults(2)
                repeat byte_count/2 as register ["Registers"]
                    uint16 value ["Register Value"] defaults(0)

        # ── 0x18 READ_FIFO_QUEUE ──────────────────────────────────────────────
        # Request  : FIFO pointer address                      (2 bytes)
        # Response : byte count + FIFO count + the queued words
        when function_code == 24:
            when remaining == 2:
                uint16 fifo_pointer ["FIFO Pointer Address"] defaults(0)
            else:
                uint16 byte_count ["Byte Count"] defaults(2)
                uint16 fifo_count ["FIFO Count"] defaults(1)
                repeat fifo_count as fifo_value ["FIFO Values"]
                    uint16 value ["Value"] defaults(0)

        # ── 0x2B MEI TRANSPORT — encapsulated interface, type then its body ───
        when function_code == 43:
            uint8 mei_type ["MEI Type"] defaults(14)
                CANOPEN_GENERAL_REFERENCE = 13
                READ_DEVICE_IDENTIFICATION = 14
            payload mei_data ["MEI Data"]

        # ── 0x14 READ_FILE_RECORD, 0x15 WRITE_FILE_RECORD and anything else ───
        else:
            payload data ["Data"]

    info "%s  Trans=%u  Unit=%u" function_code, transaction_id, unit_id
