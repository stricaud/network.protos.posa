# ── RADIUS attribute types (RFC 2865 + RFC 2866 + RFC 3576 common subset) ────
Lookup RadiusAttributeTypes
    1   = "User-Name"
    2   = "User-Password"
    3   = "CHAP-Password"
    4   = "NAS-IP-Address"
    5   = "NAS-Port"
    6   = "Service-Type"
    7   = "Framed-Protocol"
    8   = "Framed-IP-Address"
    9   = "Framed-IP-Netmask"
    10  = "Framed-Routing"
    11  = "Filter-Id"
    12  = "Framed-MTU"
    13  = "Framed-Compression"
    14  = "Login-IP-Host"
    15  = "Login-Service"
    16  = "Login-TCP-Port"
    18  = "Reply-Message"
    19  = "Callback-Number"
    20  = "Callback-Id"
    22  = "Framed-Route"
