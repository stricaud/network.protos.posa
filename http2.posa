# HTTP/2 protocol decoder — RFC 7540
# Detection: client connection preface "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" (24 bytes) at TCP offset 0.
# Frame format: 3-byte length + 1-byte type + 1-byte flags + 4-byte stream_id + payload.

Object<main> HTTP2
    abbrev "http2"
    col "HTTP2"

    required bytes<24> preface "Connection Preface"

    repeat until end as frame "Frame"
        include HTTP2Frame
        label "%s stream=%u" type, stream_id

    info "HTTP/2 %s stream=%u" type, stream_id

Object HTTP2Frame
    required uint24 length "Frame Length"
    required uint8 type "Frame Type"
        DATA          = 0
        HEADERS       = 1
        PRIORITY      = 2
        RST_STREAM    = 3
        SETTINGS      = 4
        PUSH_PROMISE  = 5
        PING          = 6
        GOAWAY        = 7
        WINDOW_UPDATE = 8
        CONTINUATION  = 9
    required uint8 flags "Flags"
    bits flags end_stream   0 1 "End Stream / ACK"
    bits flags end_headers  2 1 "End Headers"
    bits flags padded       3 1 "Padded"
    bits flags priority_bit 5 1 "Priority"
    required uint32 stream_id "Stream Identifier"
    required bytes[length] payload "Payload"

# Content detection — primary, port-independent
rule tcp.content "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n" => HTTP2

# Port hints — secondary
rule tcp.port == 443 => HTTP2
rule tcp.port == 80  => HTTP2

# Coloring rules — most specific first
color http2.type == 4 => black lightgray
color http2.type == 6 => black lightgray
color http2.type == 0 => black lightgreen
color http2.type == 1 => black lightyellow
color http2           => white darkblue

# Wireshark-compatible field aliases
alias http2.frame.type => http2.type
alias http2.stream_id  => http2.stream_id
