# RSVP header (RFC 2205) — 8 bytes
# IP protocol 46. version_flags: Ver(4)=1 | Flags(4). Objects follow the header.
# send_ttl copies the IP TTL so intermediate nodes can detect routing loops.
Object<main> RSVP
    uint8  version_flags defaults(0x10)
    uint8  msg_type defaults(1)
        PATH      = 1
        RESV      = 2
        PATHERR   = 3
        RESVERR   = 4
        PATHTEAR  = 5
        RESVTEAR  = 6
        RESVCONF  = 7
        BUNDLE    = 12
        ACK       = 13
        SREFRESH  = 15
        HELLO     = 20
    uint16 checksum defaults(0)
    uint8  send_ttl defaults(64)
    uint8  reserved defaults(0)
    uint16 rsvp_length defaults(0)
