# PTPv2 header (IEEE 1588-2008) — 34 bytes
# Over Ethernet (EtherType 0x88F7), UDP port 319 (event) / 320 (general), or raw IPv4/IPv6.
# ts_msg_type: transportSpecific(4) | messageType(4). version is always 2.
# correction_field is in nanoseconds scaled by 2^16 (subnanosecond precision).
Object<main> PTPv2
    uint8     ts_msg_type defaults(0x00)
        SYNC              = 0x00
        DELAY_REQ         = 0x01
        PDELAY_REQ        = 0x02
        PDELAY_RESP       = 0x03
        FOLLOW_UP         = 0x08
        DELAY_RESP        = 0x09
        PDELAY_RESP_FUP   = 0x0A
        ANNOUNCE          = 0x0B
        SIGNALING         = 0x0C
        MANAGEMENT        = 0x0D
    uint8     version defaults(0x02)
    uint16    message_len defaults(44)
    uint8     domain_num defaults(0)
    uint8     minor_sdoid defaults(0)
    uint16    flags defaults(0)
    bytes<8>  correction_field
    uint32    msg_type_specific defaults(0)
    bytes<8>  src_clock_id
    uint16    src_port_num defaults(1)
    uint16    seq_id defaults(0)
    uint8     control defaults(0)
    uint8     log_interval defaults(0x7F)
