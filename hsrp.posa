# HSRPv1 header (RFC 2281) — 20 bytes
# UDP port 1985, multicast 224.0.0.2. auth_data is an 8-byte plaintext password (zero-padded).
# Default priority 100; higher wins. Active router sends HELLO every helo_time seconds.
Object<main> HSRP
    uint8    version = 0
    uint8    op_code = 0
        HELLO  = 0
        COUP   = 1
        RESIGN = 2
    uint8    state = 0
        INITIAL = 0
        LEARN   = 1
        LISTEN  = 2
        SPEAK   = 4
        STANDBY = 8
        ACTIVE  = 16
    uint8    helo_time = 3
    uint8    hold_time = 10
    uint8    priority = 100
    uint8    group = 0
    uint8    reserved = 0
    bytes<8> auth_data
    ip4      virtual_ip = 0.0.0.0
