# EIGRP header (RFC 7868, Cisco EIGRP) — 20 bytes
# IP protocol 88, multicast 224.0.0.10. TLVs follow the header.
# version is always 2. sequence and ack are 0 for HELLO packets.
Object<main> EIGRP
    uint8  version defaults(2)
    uint8  opcode defaults(5)
        UPDATE    = 1
        REQUEST   = 2
        QUERY     = 3
        REPLY     = 4
        HELLO     = 5
        PROBE     = 7
        SIA_QUERY = 10
        SIA_REPLY = 11
    uint16 checksum defaults(0)
    uint32 flags defaults(0)
    uint32 sequence defaults(0)
    uint32 ack defaults(0)
    uint16 vrid defaults(0)
    uint16 as_number defaults(0)
