# http.posa — HTTP/1.x (RFC 9112).
#
# HTTP has no lengths in front of anything: it is lines of text ending in CRLF,
# then a blank line, then the body. Two posa constructs cover that shape:
#
#   string <name> until "<delim>"      one delimited token
#   repeat until "<delim>" as <item>   records until those bytes come next —
#                                      here, header lines until the blank line
#
# A request and a response differ only in their first line, so they are two
# objects in an Object<HTTP> group, told apart by their first field: a response
# starts with "HTTP", a request with a method. The group is dispatched on the
# first field's value, so "HTTP" as a uint32 (0x48545450) selects the response.
#
# Not covered (add it here, no rebuild): chunked transfer-encoding is shown as
# the raw body, and the body is not decompressed.

# ── HTTP status codes (IANA registry) ────────────────────────────────────────
Lookup HttpStatusCodes
    # 1xx Informational
    "100" = "Continue"
    "101" = "Switching Protocols"
    "102" = "Processing"
    "103" = "Early Hints"
    # 2xx Success
    "200" = "OK"
    "201" = "Created"
    "202" = "Accepted"
    "203" = "Non-Authoritative Information"
    "204" = "No Content"
    "205" = "Reset Content"
    "206" = "Partial Content"
    "207" = "Multi-Status"
    "208" = "Already Reported"
    "226" = "IM Used"
    # 3xx Redirection
    "300" = "Multiple Choices"
    "301" = "Moved Permanently"
    "302" = "Found"
    "303" = "See Other"
    "304" = "Not Modified"
    "305" = "Use Proxy"
    "307" = "Temporary Redirect"
    "308" = "Permanent Redirect"
    # 4xx Client Error
    "400" = "Bad Request"
    "401" = "Unauthorized"
    "402" = "Payment Required"
    "403" = "Forbidden"
    "404" = "Not Found"
    "405" = "Method Not Allowed"
    "406" = "Not Acceptable"
    "407" = "Proxy Authentication Required"
    "408" = "Request Timeout"
    "409" = "Conflict"
    "410" = "Gone"
    "411" = "Length Required"
    "412" = "Precondition Failed"
    "413" = "Content Too Large"
    "414" = "URI Too Long"
    "415" = "Unsupported Media Type"
    "416" = "Range Not Satisfiable"
    "417" = "Expectation Failed"
    "418" = "I'm a Teapot"
    "421" = "Misdirected Request"
    "422" = "Unprocessable Content"
    "423" = "Locked"
    "424" = "Failed Dependency"
    "425" = "Too Early"
    "426" = "Upgrade Required"
    "428" = "Precondition Required"
    "429" = "Too Many Requests"
    "431" = "Request Header Fields Too Large"
    "451" = "Unavailable For Legal Reasons"
    # 5xx Server Error
    "500" = "Internal Server Error"
    "501" = "Not Implemented"
    "502" = "Bad Gateway"
    "503" = "Service Unavailable"
    "504" = "Gateway Timeout"
    "505" = "HTTP Version Not Supported"
    "506" = "Variant Also Negotiates"
    "507" = "Insufficient Storage"
    "508" = "Loop Detected"
    "510" = "Not Extended"
    "511" = "Network Authentication Required"

Object<HTTP> HTTP_RESPONSE
    abbrev "http"
    col "HTTP"

    # the group is dispatched on the first field's value, so a response is
    # recognised by its "HTTP" magic — then `seek 0` rewinds over it, and the
    # status line is read as the text it actually is
    required uint32 magic = 0x48545450 hex "Magic"
    seek 0
    required string version until " " "Version"
    required string status_code until " " lookup HttpStatusCodes "Status Code"
    required string reason until "\r\n" "Reason Phrase"
    kvblock headers "Headers"
    required payload body "Body"

    info "%s %s" status_code, reason

Object<HTTP> HTTP_REQUEST
    abbrev "http"
    col "HTTP"
    # Only decode as a request when the payload begins with a real method — mid-
    # stream body segments (e.g. JPEG bytes of a 200 OK) start with neither this
    # nor the "HTTP" response magic, so they fall through to TCP data instead of
    # being mis-parsed as a request line.
    starts "GET " "POST " "PUT " "HEAD " "DELETE " "OPTIONS " "TRACE " "CONNECT " "PATCH "

    required string method until " " "Method"
    required string uri until " " "Request URI"
    required string version until "\r\n" "Version"
    kvblock headers "Headers"
    required payload body "Body"

    info "%s %s %s" method, uri, version

rule tcp.port == 80   => HTTP
rule tcp.port == 8080 => HTTP
rule tcp.port == 8000 => HTTP
rule tcp.port == 8888 => HTTP
rule tcp.port == 3128 => HTTP

# Content signatures — recognise HTTP on any port, not only the ones above.
# Tried only when no port rule matched; the group then tells request from
# response as usual. "HTTP/1." (a status line) is very specific; the method
# signatures keep their trailing space so "GETTER"-style false hits can't occur.
rule tcp.content "HTTP/1."  => HTTP
rule tcp.content "GET "     => HTTP
rule tcp.content "POST "    => HTTP
rule tcp.content "HEAD "    => HTTP
rule tcp.content "PUT "     => HTTP
rule tcp.content "DELETE "  => HTTP
rule tcp.content "OPTIONS " => HTTP
rule tcp.content "PATCH "   => HTTP

# Wireshark-compatible filter names → the abbrevs this decoder emits. Field
# synonyms (single target) work in comparisons too; `http.request` selects the
# request-only method field, `http.response` the response-only status field.
alias http.request        => http.method
alias http.request.method => http.method
alias http.request.uri    => http.uri
alias http.response       => http.status_code
alias http.response.code  => http.status_code
alias http.response.phrase => http.reason
# A macro alias — a named expression reusable as a filter term.
alias http.error          => http.response.code >= 400

# Wireshark paints HTTP light green; match that instead of grey.
color http => black lightgreen
