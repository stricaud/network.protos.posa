# LACP PDU (IEEE 802.3ad / 802.1AX) — subtype + version + actor TLV (22 bytes)
# EtherType 0x8809 (Slow Protocols), sent to 01:80:c2:00:00:02.
# actor_state is a bitmask; common values: 0x47=DEFAULTED|AGGREGATION|TIMEOUT|ACTIVITY,
# 0x3D=DISTRIBUTING|COLLECTING|SYNCHRONIZATION|AGGREGATION|ACTIVITY (fully up).
Object<main> LACP
    uint8    subtype defaults(0x01)
        LACP   = 0x01
        MARKER = 0x02
    uint8    version defaults(0x01)
    uint8    actor_type defaults(0x01)
    uint8    actor_len defaults(0x14)
    uint16   actor_sys_priority defaults(32768)
    bytes<6> actor_sys_id
    uint16   actor_key defaults(0)
    uint16   actor_port_priority defaults(32768)
    uint16   actor_port defaults(1)
    uint8    actor_state defaults(0x47)
        LACP_ACTIVITY    = 0x01
        LACP_TIMEOUT     = 0x02
        AGGREGATION      = 0x04
        SYNCHRONIZATION  = 0x08
        COLLECTING       = 0x10
        DISTRIBUTING     = 0x20
        DEFAULTED        = 0x40
        EXPIRED          = 0x80
    bytes<3> actor_reserved
