# raknet.posa — RakNet / Minecraft Bedrock Edition network protocol
# UDP (any port, but Minecraft Bedrock uses 19132/19133 by default).
# Reference: https://wiki.vg/Raknet_Protocol
#
# RakNet offline messages carry a 16-byte magic sequence at offset 1:
#   \x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78
#
# Offline message IDs (first byte):
#   0x01  UNCONNECTED_PING
#   0x02  UNCONNECTED_PING_OPEN_CONNECTIONS
#   0x1C  UNCONNECTED_PONG
#   0x05  OPEN_CONNECTION_REQUEST_1
#   0x06  OPEN_CONNECTION_REPLY_1
#   0x07  OPEN_CONNECTION_REQUEST_2
#   0x08  OPEN_CONNECTION_REPLY_2
#   0x09  CONNECTION_REQUEST (online — no magic)
#   0x10  CONNECTION_REQUEST_ACCEPTED
#   0x13  NEW_INCOMING_CONNECTION
#   0x15  DISCONNECT
#   0x19  CONNECTION_ATTEMPT_FAILED
#   0x1A  ALREADY_CONNECTED
#   0x1B  NEW_INCOMING_CONNECTION
#   0x1D  INCOMPATIBLE_PROTOCOL_VERSION
#
# Connected (online) packets use a different framing and are not decoded here.

Object<RAKNET> RAKNET_OFFLINE
    abbrev "raknet"
    col "RakNet"

    uint8  message_id "Message ID" defaults(0x01)
        UNCONNECTED_PING              = 0x01
        UNCONNECTED_PING_OPEN         = 0x02
        UNCONNECTED_PONG              = 0x1C
        OPEN_CONNECTION_REQUEST_1     = 0x05
        OPEN_CONNECTION_REPLY_1       = 0x06
        OPEN_CONNECTION_REQUEST_2     = 0x07
        OPEN_CONNECTION_REPLY_2       = 0x08
        INCOMPATIBLE_PROTOCOL_VERSION = 0x1D

    when message_id == 0x01:
        uint64 send_ping_time "Ping Time" defaults(0)
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")

    when message_id == 0x1C:
        uint64 send_ping_time "Ping Time" defaults(0)
        uint64 server_guid "Server GUID" defaults(0)
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")
        uint16 server_info_len "Server Info Length" defaults(0)
        str[server_info_len] server_info "Server Info"

    when message_id == 0x05:
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")
        uint8  raknet_protocol_version "RakNet Protocol Version" defaults(11)
        payload  null_padding "Null Padding (MTU)"

    when message_id == 0x06:
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")
        uint64 server_guid "Server GUID" defaults(0)
        uint8  use_security "Use Security" defaults(0)
        uint16 mtu "MTU Size" defaults(1400)

    when message_id == 0x07:
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")
        uint64 client_guid          "Client GUID"   defaults(0)
        payload  body               "Body"

    when message_id == 0x08:
        bytes<16> offline_magic hex "Offline Magic" defaults("\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78")
        uint64 server_guid          "Server GUID"   defaults(0)
        uint16 mtu                  "MTU Size"      defaults(1400)
        payload  body               "Body"

    else:
        payload body "Body"

    info "RakNet %s" message_id

Object<GROUP> RAKNET

# RakNet offline magic at offset 1
rule udp.content@1 "\x00\xff\xff\x00\xfe\xfe\xfe\xfe\xfd\xfd\xfd\xfd\x12\x34\x56\x78" => RAKNET

# Minecraft Bedrock ports
rule udp.port == 19132 => RAKNET
rule udp.port == 19133 => RAKNET

color raknet.message_id == 0x05 => black lightyellow
color raknet.message_id == 0x06 => black lightgreen
color raknet.message_id == 0x07 => black lightyellow
color raknet.message_id == 0x08 => black lightgreen
color raknet.message_id == 0x1C => black lightblue
color raknet                    => white darkblue
