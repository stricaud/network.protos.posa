# STP / RSTP BPDU (IEEE 802.1D)
# Sent to multicast 01:80:C2:00:00:00, LLC DSAP/SSAP 0x42.
# max_age/hello_time/forward_delay are in 1/256 seconds (e.g. 5120 = 20s, 512 = 2s, 3840 = 15s).
Object<main> STP
    uint16   protocol_id defaults(0)
    uint8    version defaults(0)
        STP  = 0
        RSTP = 2
        MSTP = 3
    uint8    bpdu_type defaults(0)
        CONFIG     = 0x00
        TCN        = 0x80
        RAPID_PVST = 0x02
    uint8    flags defaults(0)
    bytes<8> root_id
    uint32   root_path_cost defaults(0)
    bytes<8> bridge_id
    uint16   port_id defaults(0)
    uint16   message_age defaults(0)
    uint16   max_age defaults(5120)
    uint16   hello_time defaults(512)
    uint16   forward_delay defaults(3840)
