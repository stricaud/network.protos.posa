# NetFlow v5 export header (RFC 3954) — 24 bytes
# UDP, typically port 2055 or 9995. Flow records (48 bytes each) follow the header.
# count = number of flow records in this datagram (max 30 per UDP packet).
Object<main> NetFlowV5
    uint16 version defaults(5)
    uint16 count defaults(0)
    uint32 sys_uptime defaults(0)
    uint32 unix_secs defaults(0)
    uint32 unix_nsecs defaults(0)
    uint32 flow_sequence defaults(0)
    uint8  engine_type defaults(0)
        RP  = 0
        VIP = 1
    uint8  engine_id defaults(0)
    uint16 sampling_interval defaults(0)
