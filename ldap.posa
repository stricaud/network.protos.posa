# LDAP (Lightweight Directory Access Protocol) — RFC 4511
# BER/ASN.1 encoding over TCP port 389 (plain) or 636 (LDAPS/TLS-wrapped).
# ...

Object<main> LDAP
    abbrev "ldap"
    col "LDAP"

    required uint8 sequence_tag = 0x30 hex "Sequence Tag"
    required uint8 sequence_len "Sequence Length"

    required uint8 msg_id_tag = 0x02 hex "Message ID Tag"
    required uint8 msg_id_len "Message ID Length"
    required bytes[msg_id_len] message_id hex "Message ID"

    required uint8 op_tag hex "Operation"
        BindRequest           = 0x60
        BindResponse          = 0x61
        UnbindRequest         = 0x62
        SearchRequest         = 0x63
        SearchResultEntry     = 0x64
        SearchResultDone      = 0x65
        ModifyRequest         = 0x66
        ModifyResponse        = 0x67
        AddRequest            = 0x68
        AddResponse           = 0x69
        DelRequest            = 0x6A
        DelResponse           = 0x6B
        ModifyDNRequest       = 0x6C
        ModifyDNResponse      = 0x6D
        CompareRequest        = 0x6E
        CompareResponse       = 0x6F
        AbandonRequest        = 0x70
        SearchResultReference = 0x73
        ExtendedRequest       = 0x77
        ExtendedResponse      = 0x78
        IntermediateResponse  = 0x79

    payload

    info "id=%s %s" message_id, op_tag

rule tcp.content "\x30" => LDAP
rule tcp.port == 389 => LDAP
rule tcp.port == 636 => LDAP

color ldap.op_tag == 0x60 => black yellow    # BindRequest
color ldap.op_tag == 0x61 => black yellow    # BindResponse
color ldap.op_tag == 0x62 => black yellow    # UnbindRequest
color ldap.op_tag == 0x63 => black lightgreen  # SearchRequest
color ldap.op_tag == 0x64 => black lightgreen  # SearchResultEntry
color ldap.op_tag == 0x65 => black lightgreen  # SearchResultDone
color ldap.op_tag == 0x73 => black lightgreen  # SearchResultReference
color ldap.op_tag == 0x66 => black lightyellow  # ModifyRequest
color ldap.op_tag == 0x68 => black lightyellow  # AddRequest
color ldap.op_tag == 0x6A => black lightyellow  # DelRequest
color ldap.op_tag == 0x6C => black lightyellow  # ModifyDNRequest
color ldap.op_tag == 0x6E => black lightyellow  # CompareRequest
color ldap.op_tag == 0x70 => black lightyellow  # AbandonRequest
color ldap.op_tag == 0x67 => black lightcyan    # ModifyResponse
color ldap.op_tag == 0x69 => black lightcyan    # AddResponse
color ldap.op_tag == 0x6B => black lightcyan    # DelResponse
color ldap.op_tag == 0x6D => black lightcyan    # ModifyDNResponse
color ldap.op_tag == 0x6F => black lightcyan    # CompareResponse
color ldap.op_tag == 0x77 => white darkblue     # ExtendedRequest
color ldap.op_tag == 0x78 => white darkblue     # ExtendedResponse
color ldap.op_tag == 0x79 => white darkblue     # IntermediateResponse
color ldap => white darkgray

alias ldap.messageID => ldap.message_id
alias ldap.operation => ldap.op_tag
